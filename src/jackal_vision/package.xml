<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jackal_vision</name>
  <version>0.1.0</version>
  <description>
    YOLOv8 object detection for the Clearpath Jackal.
    Subscribes to an RGB camera topic, runs inference, and publishes
    vision_msgs/Detection2DArray so other lab nodes can consume detections
    without reading this package's code.
  </description>
  <maintainer email="ali@safirlab.org">Ali</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime (exec) dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>image_transport</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
